name: 🚀 Deploy (OCI Optimized)

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SSH_HOST }}
          username: ${{ secrets.SSH_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
        

          script: |
            set -euo pipefail

            BASE_DIR="/home/opc/apps"
            RELEASES_DIR="$BASE_DIR/releases"
            CURRENT_LINK="$BASE_DIR/current"

            NEW_RELEASE="$RELEASES_DIR/$(date +%Y%m%d%H%M%S)"

            echo "📁 Creating release directory..."
            mkdir -p "$NEW_RELEASE"

            echo "📥 Cloning repo..."
            git clone --depth=1 git@github.com:JimmyAyivor/online-toolbase.git "$NEW_RELEASE"

            cd "$NEW_RELEASE"

            echo "📦 Installing dependencies..."
            npm ci --legacy-peer-deps --no-audit --no-fund

            echo "⚙️ Loading environment..."
            if [ -f "$BASE_DIR/.env" ]; then
              set -a
              source "$BASE_DIR/.env"
              set +a
            fi

            export NODE_OPTIONS="--max-old-space-size=4096"
            export NEXT_PRIVATE_BUILD_WORKERS=$(nproc)
            export NEXT_DISABLE_TURBOPACK=1

            echo "🏗 Building app..."
            NODE_ENV=production npm run build

            echo "🧹 Pruning dev dependencies..."
            npm prune --omit=dev

            echo "🔗 Switching release atomically..."
            ln -sfn "$NEW_RELEASE" "$CURRENT_LINK"

            echo "🚀 Restarting PM2 from CURRENT"
            cd "$CURRENT_LINK"

            if pm2 describe online-tool-base > /dev/null 2>&1; then
              pm2 reload online-tool-base --update-env
            else
              pm2 start npm \
                --name online-tool-base \
                --cwd "$CURRENT_LINK" \
                -- start
            fi

            pm2 save

            echo "🧹 Cleaning old releases (keep 3)..."
            find "$RELEASES_DIR" -maxdepth 1 -mindepth 1 -type d \
              | sort -r \
              | tail -n +4 \
              | xargs -r rm -rf


      - name: Health Check + Auto Rollback
        run: |
          echo "⏳ Checking site health..."

          for i in $(seq 1 12); do
            HTTP=$(curl -s -o /dev/null -w "%{http_code}" "${{ secrets.SITE_URL }}")

            if [ "$HTTP" = "200" ]; then
              echo "✅ App is healthy"

              # IndexNow only on success
              curl -X POST "${{ secrets.SITE_URL }}/api/indexnow" \
                -H "Content-Type: application/json" \
                -H "Authorization: Bearer ${{ secrets.INDEXNOW_API_SECRET }}" \
                -d '{"mode":"full-site"}' || true

              exit 0
            fi

            echo "Attempt $i failed (HTTP $HTTP)... retrying"
            sleep 5
          done

          echo "❌ Health check failed — rolling back..."

          ssh -o StrictHostKeyChecking=no ${{ secrets.SSH_USER }}@${{ secrets.SSH_HOST }} << 'EOF'
            set -euo pipefail

            BASE_DIR="/home/opc/apps"
            RELEASES_DIR="$BASE_DIR/releases"
            CURRENT_LINK="$BASE_DIR/current"

            PREVIOUS=$(ls -dt $RELEASES_DIR/* | sed -n '2p')

            if [ -z "$PREVIOUS" ]; then
              echo "No previous release found"
              exit 1
            fi

            echo "↩️ Rolling back to $PREVIOUS"
            ln -sfn "$PREVIOUS" "$CURRENT_LINK"

            cd "$CURRENT_LINK"
            pm2 reload online-tool-base --update-env
            pm2 save
          EOF

          exit 1