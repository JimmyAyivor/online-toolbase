  // ── Product selection logic ───────────────────────────────────────────────────
  
  /**
   * Returns the best matching ClickBank product for a given tool.
   * Specific toolSlug match > category match > highest priority.
   */
  export function selectClickBankProduct(tool: {
    slug: string;
    category: string;
  }): ClickBankProduct | null {
    const active = Object.values(CLICKBANK_PRODUCTS).filter(p => p.active);
  
    // 1. Exact tool slug match (highest specificity)
    const slugMatches = active
      .filter(p => p.toolSlugs?.includes(tool.slug))
      .sort((a, b) => b.priority - a.priority);
    if (slugMatches.length > 0) return slugMatches[0];
  
    // 2. Category match
    const catMatches = active
      .filter(p => p.categories.includes(tool.category))
      .sort((a, b) => b.priority - a.priority);
    if (catMatches.length > 0) return catMatches[0];
  
    return null;
  }
  
  /**
   * Builds the ClickBank hoplink for a product.
   * tid (tracking ID) lets you see which tool drove the conversion in CB reporting.
   */
  export function buildHopLink(
    vendorId: string,
    affiliateId: string,
    toolSlug: string
  ): string {
    return `https://${affiliateId}.${vendorId}.hop.clickbank.net/?tid=${toolSlug}`;
  }