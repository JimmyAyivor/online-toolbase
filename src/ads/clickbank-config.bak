// src/ads/clickbank-config.ts
//
// ClickBank affiliate product catalog for https://www.utilvia.com

//
// ── How ClickBank hoplinks work ───────────────────────────────────────────────
// Format: https://[YOUR_AFFILIATE_ID].[VENDOR_ID].hop.clickbank.net/
// Optional tracking ID: append ?tid=[tool-slug] to track which page drove the sale
//
// ── Setup ────────────────────────────────────────────────────────────────────
// 1. Sign up at clickbank.com → Accounts → Create account (affiliate)
// 2. Your affiliate nickname is your CLICKBANK_AFFILIATE_ID (e.g. "jimmytools")
// 3. For each product below, find it in the ClickBank Marketplace → get vendor ID
// 4. Set CLICKBANK_AFFILIATE_ID in .env
// 5. Each product link is auto-built as https://[yours].[vendor].hop.clickbank.net/?tid=[tool]
//
// ── Commission rates (typical ClickBank) ─────────────────────────────────────
// Health products:      50–75% per sale ($20–$90 avg commission)
// Marketing/SEO:        40–60% per sale ($30–$200 avg commission)
// Finance/Trading:      40–60% per sale ($50–$150 avg commission)
// Writing/Software:     50–75% per sale ($20–$60 avg commission)
// Recurring products:   30–50% monthly (compounding revenue)
//
// ── Add to .env ──────────────────────────────────────────────────────────────
// CLICKBANK_AFFILIATE_ID=your_nickname_here
//
// ── SQL for click tracking (run once) ────────────────────────────────────────
// create table clickbank_clicks (
//   id          uuid primary key default gen_random_uuid(),
//   product_key text not null,
//   vendor_id   text not null,
//   tool_slug   text,
//   ip          text,
//   user_agent  text,
//   created_at  timestamptz not null default now()
// );
// create index on clickbank_clicks (product_key, created_at desc);
// create index on clickbank_clicks (tool_slug, created_at desc);

export type ClickBankProduct = {
    /** Internal key — used in URLs and DB */
    key: string;
    /** ClickBank vendor account ID (the seller's nickname) */
    vendorId: string;
    /** Product display name */
    name: string;
    /** One-line value proposition — what the user gets */
    headline: string;
    /** Supporting description — 1–2 sentences, outcome-focused */
    description: string;
    /** Badge text shown on the card — e.g. "Most popular" or "75% commission" */
    badge?: string;
    /** Emoji icon for the card */
    icon: string;
    /** Tool categories this product targets */
    categories: string[];
    /** Also show on these specific tool slugs regardless of category */
    toolSlugs?: string[];
    /** Priority 1–10 — higher wins when multiple products match */
    priority: number;
    /** Commission percentage shown to you (for internal reference) */
    commissionPct: number;
    /** Whether this product is currently active */
    active: boolean;
  };
  
